
921_min_AddToMakeValidParenthesis
Problem:https://leetcode.com/problems/minimum-add-to-make-parentheses-valid/description/?source=submission-ac


class Solution {
    public int minAddToMakeValid(String s) {
        int open=0;
        int moves=0;
    for (char ch : s.toCharArray()){
            if(ch=='('){
                open++;

            }
            else{
                if(open>0){
                    open--;
                }
                else moves++;

            }
        }
        return moves+open;

    }
}

// By using Stack

class Solution {
        public int minAddToMakeValid(String s) {
        Stack<Character>st=new Stack<>();
        int count=0;
        for(int i=0;i<s.length();i++){
          if (s.charAt(i) == '(')
              st.push(s.charAt(i));

          else 
                if(st.empty())
                count++;
                else
                  st.pop(); 

              }
              return count+st.size();
        }
   }
