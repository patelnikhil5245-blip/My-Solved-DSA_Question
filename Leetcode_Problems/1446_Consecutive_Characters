
1446.Consecutive Characters:https://leetcode.com/problems/consecutive-characters/submissions/2105324881/

class Solution {
    public int maxPower(String s) {
      int maxCount = 1;
       int count = 1;

     for (int i = 1; i < s.length(); i++) {

    if (s.charAt(i) == s.charAt(i - 1)) {
        count++;
    } else {
        count = 1;
    }

    if (count > maxCount) {
        maxCount = count;
       
         }
       }
       return maxCount;
    }
}

