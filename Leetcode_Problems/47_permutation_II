class Solution {
    
    public List<List<Integer>> permuteUnique(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        permute(nums, ans, 0);
        return ans;
    }

    private void permute(int[] arr, List<List<Integer>> ans, int index) {
        if (index == arr.length) {
            List<Integer> temp = new ArrayList<>();
            for (int num : arr) {
                temp.add(num);
            }
            ans.add(temp);
            return;
        }

        boolean[] used = new boolean[21]; // Values assumed in range [-10, 10]

        for (int i = index; i < arr.length; i++) {
            if (!used[arr[i] + 10]) {
                swap(arr, i, index);
                permute(arr, ans, index + 1);
                swap(arr, i, index);
                used[arr[i] + 10] = true;
            }
        }
    }

    private void swap(int[] arr, int i, int j) {
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }
  
}       

// 2nd method ,Bu using the hashset

class Solution {

    public List<List<Integer>> permuteUnique(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        permute(nums, ans, 0);
        return ans;
    }

    private void permute(int[] arr, List<List<Integer>> ans, int index) {
        if (index == arr.length) {
            List<Integer> temp = new ArrayList<>();
            for (int num : arr) {
                temp.add(num);
            }
            ans.add(temp);
            return;
        }

        HashSet<Integer> used = new HashSet<>();

        for (int i = index; i < arr.length; i++) {
            if (!used.contains(arr[i])) {
                used.add(arr[i]);

                swap(arr, i, index);
                permute(arr, ans, index + 1);
                swap(arr, i, index);
            }
        }
    }

    private void swap(int[] arr, int i, int j) {
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }
}

