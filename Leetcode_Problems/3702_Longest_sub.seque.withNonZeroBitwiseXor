
3702:Longest sub Sequence with Non-zero bitwise XOR
https://leetcode.com/problems/longest-subsequence-with-non-zero-bitwise-xor/description/?envType=daily-question&envId=2026-08-15

class Solution {
    public int longestSubsequence(int[] nums) {
        int xor = 0;
        boolean hasNonZero = false;

        for (int num : nums) {
            xor ^= num;

            if (num != 0) {
                hasNonZero = true;
            }
        }
        if (xor != 0) {
            return nums.length;
        }

        // Total XOR is zero, but we can remove one non-zero element
        if (hasNonZero) {
            return nums.length - 1;
        }

        // All elements are zero
        return 0;

    }
}

