
37_Suduko Solver Problem:https://leetcode.com/problems/sudoku-solver/description/

class Solution {

    boolean solve(char[][] board, int row, int col) {

        // Base case
        if (row == 9) {
            return true;
        }

        // Calculate next cell
        int nextRow = (col == 8) ? row + 1 : row;
        int nextCol = (col == 8) ? 0 : col + 1;

        // Skip filled cells
        if (board[row][col] != '.') {
            return solve(board, nextRow, nextCol);
        }

        // Try digits 1 to 9
        for (char ch = '1'; ch <= '9'; ch++) {

            if (isValid(board, row, col, ch)) {

                // Place digit
                board[row][col] = ch;

                // Recur
                if (solve(board, nextRow, nextCol)) {
                    return true;
                }

                // Backtrack
                board[row][col] = '.';
            }
        }

        return false;
    }

    boolean isValid(char[][] board, int row, int col, char ch) {

        for (int i = 0; i < 9; i++) {

            // Check row
            if (board[row][i] == ch)
                return false;

            // Check column
            if (board[i][col] == ch)
                return false;

            // Check 3x3 subgrid
            int r = 3 * (row / 3) + i / 3;
            int c = 3 * (col / 3) + i % 3;

            if (board[r][c] == ch)
                return false;
        }

        return true;
    }

    public void solveSudoku(char[][] board) {
        solve(board, 0, 0);
    }
}