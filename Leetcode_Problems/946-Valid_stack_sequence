
946 Valid Stack sequence :https://leetcode.com/problems/validate-stack-sequences/description/

class Solution {
    public boolean validateStackSequences(int[] pushed, int[] popped) {
        int n = pushed.length;

        Stack<Integer> st = new Stack<>();

        int i = 0;
        int j = 0;

        while (i < n || !st.empty()) {

            if (st.empty()) {
                if (i < n) {
                    st.push(pushed[i]);
                    i++;
                }
            }
            else if (j < n && st.peek() == popped[j]) {
                st.pop();
                j++;
            }
            else {
                if (i < n) {
                    st.push(pushed[i]);
                    i++;
                }
                else {
                    break;
                }
            }
        }

        return st.empty() && j == n;
    }
}

