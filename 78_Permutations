import java.util.*;

class Solution {
    public List<List<Integer>> permute(int[] nums) {

        List<List<Integer>> ans = new ArrayList<>();
        int n = nums.length;

        List<Boolean> visited = new ArrayList<>(Collections.nCopies(n, false));
        List<Integer> temp = new ArrayList<>();

        permutationCount(nums, ans, temp, visited);

        return ans;
    }

    public void permutationCount(int[] nums, List<List<Integer>> ans,
                                 List<Integer> temp, List<Boolean> visited) {

        if (temp.size() == nums.length) {
            ans.add(new ArrayList<>(temp));   // Make a copy
            return;
        }

        for (int i = 0; i < nums.length; i++) {
            if (!visited.get(i)) {

                visited.set(i, true);      // Mark visited
                temp.add(nums[i]);

                permutationCount(nums, ans, temp, visited);

                temp.remove(temp.size() - 1);
                visited.set(i, false);     // Backtrack
            }
        }
    }
}