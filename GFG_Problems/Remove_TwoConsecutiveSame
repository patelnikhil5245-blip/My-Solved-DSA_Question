
Remove Two Consecutive Same:https://www.geeksforgeeks.org/problems/string-manipulation3706/1?page=1&difficulty%5B%5D=0&category%5B%5D=Stack&sortBy=submissions

class Solution {
    public int removeConsecutiveSame(String[] arr) {
        // code here
        Stack<String>st=new Stack<>();
        for(int i=0;i<arr.length;i++){
            if(st.empty()){
                st.push(arr[i]);
            }
            else if(st.peek().equals(arr[i])){
                    st.pop();
                }
            else
                 st.push(arr[i]);
        }
        return st.size();
    }
}
