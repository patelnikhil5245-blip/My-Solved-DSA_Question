
 Next Greater Element in Circular Array

https://www.geeksforgeeks.org/problems/next-greater-element/1

class Solution {
    public ArrayList<Integer> nextGreater(int[] arr) {

        Stack<Integer> st = new Stack<>();
        ArrayList<Integer> ans = new ArrayList<>();

        int n = arr.length;

        // Initially all answers are -1
        for (int i = 0; i < n; i++) {
            ans.add(-1);
        }

        // Traverse array twice
        for (int i = 0; i < 2 * n; i++) {

            int index = i % n;

            while (!st.isEmpty() && arr[st.peek()] < arr[index]) {
                int prevIndex = st.pop();
                ans.set(prevIndex, arr[index]);
            }

            // Only push indices from first traversal
            if (i < n) {
                st.push(index);
            }
        }

        return ans;
    }
}  