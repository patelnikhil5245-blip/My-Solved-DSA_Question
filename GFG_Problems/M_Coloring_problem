class Solution {

    private boolean isSafe(int node, int color, int[] colors,List<Integer>[] graph) {

        for (int neighbor : graph[node]) {
            if (colors[neighbor] == color) {
                return false;
            }
        }

        return true;
    }

    private boolean solve(int node, int[] colors,List<Integer>[] graph, int m, int V) {

        if (node == V) {
            return true;
        }

        for (int c = 1; c <= m; c++) {

            if (isSafe(node, c, colors, graph)) {

                colors[node] = c;

                if (solve(node + 1, colors, graph, m, V)) {
                    return true;
                }

                colors[node] = 0;
            }
        }

        return false;
    }

    public boolean graphColoring(int V, int[][] edges, int m) {

        List<Integer>[] graph = new ArrayList[V];

        for (int i = 0; i < V; i++) {
            graph[i] = new ArrayList<>();
        }

        // Build adjacency list
        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];

            graph[u].add(v);
            graph[v].add(u);
        }

        int[] colors = new int[V];

        return solve(0, colors, graph, m, V);
    }
} 
