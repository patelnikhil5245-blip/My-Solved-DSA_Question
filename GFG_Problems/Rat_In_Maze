
Rate in a Maze Problem:https://www.geeksforgeeks.org/problems/rat-in-a-maze-problem/1

class Solution {
    public ArrayList<String> ratInMaze(int[][] maze) {
        // code here
        int n = maze.length;
        ArrayList<String> ans = new ArrayList<>();

        if (maze[0][0] == 0 || maze[n - 1][n - 1] == 0)
            return ans;

        boolean[][] visited = new boolean[n][n];

        solve(maze, 0, 0, n, new StringBuilder(), ans, visited);

        Collections.sort(ans);   // Optional (required in GFG)

        return ans;
    }
    
   public boolean isValid(int i, int j, int n) {
        return i >= 0 && j >= 0 && i < n && j < n;
       }

    public void solve(int[][] maze, int i, int j, int n, StringBuilder path,ArrayList<String> ans,boolean[][] visited) 
         {
        // Base Case
        if (i == n - 1 && j == n - 1) {
            ans.add(path.toString());
            return;
        }

        visited[i][j] = true;

        // U, D, L, R
        int[] row = {-1, 1, 0, 0};
        int[] col = {0, 0, -1, 1};
        char[] dir = {'U', 'D', 'L', 'R'};

        for (int k = 0; k < 4; k++) {
            int nextI = i + row[k];
            int nextJ = j + col[k];

            if (isValid(nextI, nextJ, n)
                    && maze[nextI][nextJ] == 1
                    && !visited[nextI][nextJ]) {

                path.append(dir[k]);

                solve(maze, nextI, nextJ, n, path, ans, visited);

                // Backtrack
                path.deleteCharAt(path.length() - 1);
            }
        }

        visited[i][j] = false;
    }
}

